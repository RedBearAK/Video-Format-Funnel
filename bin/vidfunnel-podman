#!/bin/sh
# vidfunnel-podman: run vidfunnel inside its container image. Every argument that
# is an existing path on the host is bind-mounted read-write at the same absolute
# path inside the container (and at its symlink-resolved path when that differs),
# as is the current directory (the container's working directory), and the
# container runs as the invoking uid/gid. --quarantine and --db targets are
# created on the host first and mounted. HOME is passed in, with its vidfunnel
# state and cache folders mounted. --ffmpeg is refused. --install-command and
# --uninstall-command run on the host and link 'vidfunnel' to this wrapper.
# plan, convert and verify run in a detached, labelled container that the wrapper
# follows; 'attach' follows one again and 'stop' drains or stops one.
# See HANDOFF.md section 8.

VERSION="20261109"

set -eu
set -f
unset CDPATH

VIDFUNNEL_IMAGE_DIGEST=""

IMAGE="${VIDFUNNEL_IMAGE:-localhost/vidfunnel:latest}"
BUILD=0
STOP_GRACE_SECONDS=30

usage() {
    cat <<EOF2
Usage: vidfunnel-podman [wrapper options] [vidfunnel arguments]

Runs vidfunnel in its container image with podman (or docker, if podman is not
installed). Wrapper options are recognised only before the first other argument;
everything from there on goes to vidfunnel unchanged.

Wrapper options:
  --image IMAGE      image to run (default: ${IMAGE}; environment: VIDFUNNEL_IMAGE)
  --build            build the image from the Containerfile next to this script's
                     repo, tag it as the image above, then run (or just build, when
                     no vidfunnel arguments follow)
  --wrapper-version  print the wrapper version
  -h, --help         this text

What the wrapper does:
  Every vidfunnel argument that is an existing file or folder on the host is
  resolved to an absolute path and bind-mounted read-write at the same path inside
  the container. The current directory is mounted too and used as the working
  directory. A file argument mounts its folder, not the file alone, because
  vidfunnel writes its records, output and sidecars beside the source. Each
  folder is also mounted at its physical path (symlinks resolved, as 'pwd -P'
  gives it) when that differs, and when the argument is a symlink, every link
  on the way and the folder it ends in are mounted too, so a symlink inside a
  mounted folder that points to another disk still leads somewhere inside the
  container. A path inside another mounted folder is not mounted separately,
  and '/' is never mounted (the wrapper stops instead).
  Paths that vidfunnel will create are prepared on the host first, so they are
  not written into the container's own filesystem (removed with the container):
    --quarantine DIR, --quarantine=DIR   DIR is created on the host (mkdir -p)
                                         and mounted
    --db PATH, --db=PATH                 the folder holding PATH is created on
                                         the host (mkdir -p) and mounted
  Option values given with '=' are mounted like separate arguments when they
  exist: report --from=REPORT and find --root=PATH. After the subcommand that
  has the option, the abbreviations argparse accepts are treated like the full
  name, with or without '=': --q (and longer) for --quarantine after 'retire';
  --d for --db after 'index', 'find' and 'report'; --fr for --from after
  'report'; --r for --root after 'find'. The full names --quarantine and --db
  are prepared wherever they appear.
  A --quarantine directory that cannot be created or is still not under a
  mounted path stops the wrapper before the container starts.
  --ffmpeg PATH and --ffmpeg=PATH (and their abbreviations, such as --ff) are
  refused before the container starts: the image's own ffmpeg is the only one
  that works inside it. VIDFUNNEL_FFMPEG from the host environment is not passed
  into the container.
  The container gets your HOME (-e HOME=\$HOME), and the wrapper creates
  \$HOME/.local/state/vidfunnel (the index database) and \$HOME/.cache/vidfunnel
  (the ffmpeg capability cache) on the host and mounts both at the same path,
  so they persist between runs, are owned by you, and nothing reaches the
  current directory by way of '~'. Without -e HOME, the passwd entry that
  --userns=keep-id adds gives a home that is not usable ('/' on one host, the
  working directory on another). Inside the container HOME's own directory is
  root-owned and not writable unless HOME is under the working directory, which
  is mounted whole; otherwise only the two mounted folders are, and vidfunnel
  writes nothing else under HOME. Both folders are also mounted at their
  physical path when ~/.cache or ~/.local/state is a symlink to another disk.
  An unset or empty HOME stops the wrapper.
  The container runs with --rm (attached runs; detached ones are removed by the
  wrapper, see below), --userns=keep-id (podman) or --user uid:gid
  (docker) so files are owned by you, and --security-opt label=disable for SELinux
  hosts. It gets a terminal (-it) only when both stdin and stdout are terminals;
  piped ('| less', '| tee', '> file') it gets no terminal and no stdin at all, so
  the pipe's reader owns the terminal and nothing is left in raw mode afterwards.
  Your supplementary groups are kept inside the container when they can be, so a
  share writable only through a group (root:media 775 on a NAS mount) stays
  writable: with podman on the crun runtime through --group-add keep-groups; with
  docker through --group-add for each of your group ids. podman on runc cannot
  keep them (runc ignores keep-groups, and numeric ids map to subordinate gids
  under keep-id); the wrapper then prints a warning naming each mounted folder
  that you can write only through one of those groups (owned by someone else,
  group-writable, not writable by others, its group one of your supplementary
  groups), and no warning when no mounted folder depends on one.
  The host's /etc/machine-id, when it exists and is not empty, is mounted
  read-only at the same path, so the folder locks a container run writes carry
  this machine's id: a lock written before the machine's last reboot is then
  taken over at once, by a run in a container or on the host. Without it (a
  Mac, where podman and docker run in a VM, has no such file) the image has no
  machine id, vidfunnel records the boot id instead, and such a lock is judged
  by the other lock rules.

Installing the command:
  --install-command and --uninstall-command (or an abbreviation argparse
  accepts, such as --install), given among the options before the subcommand,
  run on the host instead of in the container. The wrapper looks for them up to
  the first argument that is neither an option nor the value of --ffmpeg or
  --launcher, and not past '--'; 'check --install-command' goes to the
  container. They need neither podman nor docker. With --build, the image is
  built first (which does need one of them), then the command is installed.
  They make or remove a symlink 'vidfunnel' in ~/.local/bin (or
  /usr/local/bin with --system) pointing at this wrapper, so that 'vidfunnel'
  runs the container. With a python3 of 3.9 or newer on the host, the repo's
  own installer does it (with --launcher set to this wrapper), including the
  offer to add ~/.local/bin to PATH. Without one, the wrapper does it itself:
  it replaces only a symlink to this wrapper or to bin/vidfunnel, refuses
  anything else, prints the PATH line to add instead of editing any file, and
  for --system needs /usr/local/bin to be writable (otherwise it prints the
  sudo ln -s command to run); its --uninstall-command removes only a symlink
  to this wrapper or to bin/vidfunnel. The repo's installer removes only a
  symlink to this wrapper.

Long runs (plan, convert, verify) are detached:
  These stages run in a detached container (podman run -d) named
  vidfunnel-STAGE-HASH (HASH: the first 12 hex digits of the sha256 of the
  working directory and the first path argument) and labelled vidfunnel=1 with
  the stage, working directory, path arguments and start time. The wrapper then
  follows its output (podman logs -f) and, when the container exits, removes it
  and exits with the container's exit code. The run therefore survives the
  terminal: if the wrapper, its terminal or a '| tee' after it dies, the
  container goes on, and 'attach' follows it again. Detached containers get no
  terminal and no stdin, so progress arrives as whole lines, also when you run
  in a terminal. Other subcommands, any help request, and retire's prompt run
  attached as described above.
  Ctrl+C while following stops the container (podman stop: SIGTERM, which
  vidfunnel handles like Ctrl+C) and keeps following until it has exited; a
  second Ctrl+C stops following and leaves the container to finish its stop on
  its own. A closed terminal (SIGHUP), SIGTERM or SIGQUIT to the wrapper stop
  only the following; the container keeps running.
  A container of the same name that has exited (its wrapper died before
  removing it) is reported with its exit code and last 20 lines, removed, and
  the new run starts. A run is refused (exit 1) while a container of the same
  name, or one working on the same paths (the path arguments, or the working
  directory when there are none), is running on this host; the message names
  it. Containers on other hosts are not visible to podman here: between hosts,
  the folder locks on the share keep two runs out of the same folder.
  VIDFUNNEL_ATTACHED=1 runs these stages attached, as the other subcommands.

Wrapper commands (handled by the wrapper, not passed to vidfunnel):
  attach             lists the vidfunnel containers on this host (running and
                     exited, with stage, folder, paths, start time, status);
                     when exactly one of them was started in the current
                     directory (a running one preferred), follows that one
  attach NAME        follows the container NAME, or the one whose name starts
                     with NAME; the whole log is replayed first, so
                     'attach NAME | tee -a LOG' fills in what a dead '| tee LOG'
                     missed. When the container has exited, its exit code is
                     the wrapper's and the container is removed.
  attach --clean     removes the exited vidfunnel containers, printing each
                     one's exit code first
  stop [NAME]        this host's run: asks it to drain (podman kill --signal
                     USR1): the items in progress finish, no new ones start,
                     and vidfunnel exits normally, so the server can be
                     rebooted without losing the encodes in progress; then
                     follows its output until it exits. Without NAME, the one
                     running container started in the current directory;
                     otherwise the list is printed and a NAME is needed.
  stop --now [NAME]  stops it at once (podman stop: SIGTERM, SIGKILL after
                     ${STOP_GRACE_SECONDS} seconds), then follows it
  Following in attach and stop handles Ctrl+C, SIGHUP and SIGTERM as above.
  'stop' is for this host only: a path argument (an existing file or folder, or
  anything with a '/') is refused. vidfunnel's own 'stop-all PATH...' stops
  every run under PATH on every host, through the share, and 'resume PATH...'
  lifts that (deleting PATH/.vidfunnel/stop does the same); both run in the
  container, attached, like 'check'.
  Installed as 'vidfunnel', these are 'vidfunnel attach' and 'vidfunnel stop'.

Environment:
  VIDFUNNEL_IMAGE          image name, overridden by --image
  VIDFUNNEL_NICE           if set, run the container command under nice -n VALUE
  VIDFUNNEL_IONICE_CLASS   if set and ionice exists, run under ionice -c VALUE
  VIDFUNNEL_ATTACHED       1 runs plan, convert and verify attached (no detached
                           container, no name, no attach)

Pinning: the variable VIDFUNNEL_IMAGE_DIGEST near the top of this script is empty
by default. When it holds a digest (sha256:...), the wrapper runs IMAGE@DIGEST, so
the image changes only when the digest is edited on purpose.
EOF2
}

say() { printf '%s\n' "$*"; }
die() { printf 'vidfunnel-podman: %s\n' "$*" >&2; exit 1; }

while [ $# -gt 0 ]; do
    case "$1" in
        --image) [ $# -ge 2 ] || die "--image needs a value"; IMAGE="$2"; shift 2 ;;
        --build) BUILD=1; shift ;;
        --wrapper-version) say "vidfunnel-podman ${VERSION}"; exit 0 ;;
        -h|--help) usage; exit 0 ;;
        *) break ;;
    esac
done

case "${VIDFUNNEL_ATTACHED:-}" in
    ""|0|1) ;;
    *) die "VIDFUNNEL_ATTACHED is '${VIDFUNNEL_ATTACHED}'; set it to 1 to run plan, convert and verify attached, or leave it unset" ;;
esac

self="$0"
while [ -L "$self" ]; do
    target=$(readlink "$self")
    case "$target" in
        /*) self="$target" ;;
        *) self="$(dirname "$self")/$target" ;;
    esac
done
bindir=$(cd "$(dirname "$self")" && pwd -P)
root=$(dirname "$bindir")
wrapper="${bindir}/vidfunnel-podman"
plain_launcher="${bindir}/vidfunnel"

[ -n "${HOME:-}" ] || die "HOME is not set (or is empty); it is needed for the container's HOME and for --install-command"
case "${HOME}" in
    /*) ;;
    *) die "HOME is '${HOME}', not an absolute path; refusing to guess where the container's HOME should be" ;;
esac

install_hint() {
    if [ "$(uname -s)" = "Darwin" ]; then
        say "  brew install podman"
        return
    fi
    id=""
    [ -r /etc/os-release ] && id=$(. /etc/os-release && echo "${ID:-} ${ID_LIKE:-}")
    case " $id " in
        *" opensuse"*|*" suse "*) say "  sudo zypper install podman" ;;
        *" fedora "*|*" rhel "*) say "  sudo dnf install podman" ;;
        *" debian "*|*" ubuntu "*) say "  sudo apt install podman" ;;
        *" arch "*) say "  sudo pacman -S podman" ;;
        *" alpine "*) say "  sudo apk add podman" ;;
        *) say "  install podman with your package manager" ;;
    esac
}

is_option_prefix() {
    case "$2" in "$1"*) ;; *) return 1 ;; esac
    [ "${#1}" -ge "${#3}" ]
}

is_ffmpeg_option() { is_option_prefix "$1" "--ffmpeg" "--f"; }

install_mode=""
ffmpeg_given=""
skip_value=0
for arg in "$@"; do
    if [ "${skip_value}" -eq 1 ]; then
        skip_value=0
        continue
    fi
    case "${arg}" in
        --) break ;;
        --*=*)
            is_ffmpeg_option "${arg%%=*}" && ffmpeg_given="${arg}"
            ;;
        -*)
            if is_option_prefix "${arg}" "--install-command" "--i"; then
                install_mode="install"; break
            elif is_option_prefix "${arg}" "--uninstall-command" "--un"; then
                install_mode="uninstall"; break
            elif is_ffmpeg_option "${arg}"; then
                ffmpeg_given="${arg}"; skip_value=1
            elif is_option_prefix "${arg}" "--launcher" "--l"; then
                skip_value=1
            fi
            ;;
        *) break ;;
    esac
done

if [ -z "${install_mode}" ] && [ -n "${ffmpeg_given}" ]; then
    die "'${ffmpeg_given}' is refused: the image's own ffmpeg is the only one that works inside the container (a host ffmpeg is not mounted and is usually built for another C library); leave --ffmpeg out"
fi

find_engine() {
    if command -v podman >/dev/null 2>&1; then
        ENGINE="podman"
    elif command -v docker >/dev/null 2>&1; then
        ENGINE="docker"
        say "vidfunnel-podman: podman was not found, using 'docker' instead" >&2
    else
        {
            say "vidfunnel-podman: neither podman nor docker was found on PATH. Install podman with:"
            install_hint
        } >&2
        exit 1
    fi
}

if [ "${BUILD}" -eq 1 ]; then
    find_engine
    [ -f "${root}/Containerfile" ] || die "no Containerfile in '${root}'"
    say "Building image '${IMAGE}' from '${root}/Containerfile' with ${ENGINE}"
    "${ENGINE}" build -t "${IMAGE}" -f "${root}/Containerfile" "${root}"
    if [ $# -eq 0 ]; then
        say "Built '${IMAGE}'"
        exit 0
    fi
fi

host_python_ok() {
    command -v python3 >/dev/null 2>&1 || return 1
    python3 -c 'import sys; sys.exit(0 if sys.version_info >= (3, 9) else 1)' 2>/dev/null
}

link_is_ours() {
    raw=$(readlink "$1") || return 1
    case "${raw}" in
        /*) ;;
        *) raw="$(dirname "$1")/${raw}" ;;
    esac
    if [ -e "${raw}" ]; then
        raw="$(cd "$(dirname "${raw}")" && pwd -P)/$(basename "${raw}")"
    fi
    [ "${raw}" = "${wrapper}" ] || [ "${raw}" = "${plain_launcher}" ]
}

describe_target() {
    if [ -L "$1" ]; then
        printf "a symlink to '%s'" "$(readlink "$1")"
    elif [ -d "$1" ]; then
        printf 'a directory'
    else
        printf 'a file that is not a symlink'
    fi
}

path_advice() {
    user_bin="${HOME}/.local/bin"
    case ":${PATH:-}:" in
        *":${user_bin}:"*|*":${user_bin}/:"*) return 0 ;;
    esac
    say "'${user_bin}' is not on PATH."
    shell_name=$(basename "${SHELL:-}")
    case "${shell_name}" in
        bash)
            say "For bash, add this line to '~/.bashrc':"
            say '    export PATH="$HOME/.local/bin:$PATH"' ;;
        zsh)
            say "For zsh, add this line to '~/.zprofile':"
            say '    export PATH="$HOME/.local/bin:$PATH"' ;;
        fish)
            say "For fish, add this line to '~/.config/fish/config.fish':"
            say '    fish_add_path -g $HOME/.local/bin' ;;
        *)
            say "Add this line, or its equivalent, to your shell's startup file:"
            say '    export PATH="$HOME/.local/bin:$PATH"' ;;
    esac
    say "This wrapper edits no file; until then, 'vidfunnel' is found only by its full path."
}

sh_install_command() {
    scope="user"
    for arg in "$@"; do
        if is_option_prefix "${arg}" "--install-command" "--i" \
            || is_option_prefix "${arg}" "--uninstall-command" "--un" \
            || is_option_prefix "${arg}" "--yes" "--y"; then
            continue
        fi
        case "${arg}" in
            --us|--use|--user) scope="user" ;;
            --s|--sy|--sys|--syst|--syste|--system) scope="system" ;;
            *) die "'${arg}' is not understood by the wrapper's own installer (it takes --user, --system and --yes)" ;;
        esac
    done
    if [ "${scope}" = "system" ]; then
        link_dir="/usr/local/bin"
    else
        link_dir="${HOME}/.local/bin"
    fi
    link="${link_dir}/vidfunnel"
    if [ "${install_mode}" = "uninstall" ]; then
        if [ ! -e "${link}" ] && [ ! -L "${link}" ]; then
            say "Nothing installed at '${link}'."
            return 0
        fi
        link_is_ours "${link}" || die "'${link}' is $(describe_target "${link}"), not a symlink to '${wrapper}' or '${plain_launcher}'; leaving it alone"
        if [ "${scope}" = "system" ] && [ ! -w "${link_dir}" ]; then
            die "'${link_dir}' is not writable; remove the link by hand with: sudo rm '${link}'"
        fi
        rm -f -- "${link}" || die "could not remove '${link}'"
        { [ -e "${link}" ] || [ -L "${link}" ]; } && die "'${link}' is still there after removing it"
        say "Removed '${link}'."
        return 0
    fi
    if [ "${scope}" = "system" ] && [ ! -w "${link_dir}" ]; then
        die "'${link_dir}' is not writable; make the link by hand with: sudo ln -s '${wrapper}' '${link}'"
    fi
    if [ -e "${link}" ] || [ -L "${link}" ]; then
        link_is_ours "${link}" || die "'${link}' already exists and is $(describe_target "${link}"); not overwriting it. Remove it yourself if it should be replaced."
    fi
    mkdir -p -- "${link_dir}" || die "cannot create '${link_dir}'"
    temp_link="${link}.vidfunnel-tmp"
    rm -f -- "${temp_link}"
    ln -s -- "${wrapper}" "${temp_link}" || die "could not create '${temp_link}'"
    mv -f -- "${temp_link}" "${link}" || die "could not move '${temp_link}' to '${link}'"
    [ -L "${link}" ] && [ "$(readlink "${link}")" = "${wrapper}" ] || die "'${link}' is not a symlink to '${wrapper}' after installing"
    say "Installed '${link}' -> '${wrapper}'."
    if [ "${scope}" = "user" ]; then
        path_advice
    fi
    return 0
}

if [ -n "${install_mode}" ]; then
    [ -f "${root}/vidfunnel/installer.py" ] || die "the repo's installer '${root}/vidfunnel/installer.py' is missing"
    if host_python_ok; then
        # Our --launcher goes first, so a trailing subcommand word ('--install-command check')
        # still parses; a --launcher the user gave is dropped, since this wrapper is the launcher.
        count=$#
        i=0
        skip_value=0
        while [ "${i}" -lt "${count}" ]; do
            arg="$1"
            shift
            if [ "${skip_value}" -eq 1 ]; then
                skip_value=0
            elif is_option_prefix "${arg}" "--launcher" "--l"; then
                skip_value=1
            else
                case "${arg}" in
                    --*=*) is_option_prefix "${arg%%=*}" "--launcher" "--l" || set -- "$@" "${arg}" ;;
                    *) set -- "$@" "${arg}" ;;
                esac
            fi
            i=$((i + 1))
        done
        exec env PYTHONPATH="${root}${PYTHONPATH:+:$PYTHONPATH}" python3 -m vidfunnel --launcher "${wrapper}" "$@"
    fi
    say "No python3 of 3.9 or newer on the host; using the wrapper's own installer (it edits no shell startup file)."
    sh_install_command "$@"
    exit 0
fi

[ -n "${ENGINE:-}" ] || find_engine

# Detached runs, 'attach' and 'stop'. plan, convert and verify run in a detached,
# named and labelled container that the wrapper follows with 'logs -f', so the run
# survives the terminal, the wrapper and a '| tee' after it. The container is not
# started with --rm: podman's own cleanup would remove it as it exits, racing the
# 'wait' that reads its exit code (seen with podman 6.1.4 and the k8s-file log
# driver), and an exited container whose wrapper died is what 'attach' replays.
# The wrapper removes it once it has the exit code.

NEWLINE='
'

command_name() {
    shown=$(basename "$0")
    if [ "$(command -v "${shown}" 2>/dev/null || true)" = "$0" ]; then
        printf '%s' "${shown}"
    else
        printf '%s' "$0"
    fi
}

now_utc() { date -u +%Y-%m-%dT%H:%M:%SZ; }

container_field() {
    "${ENGINE}" inspect --type container --format "$2" "$1" 2>/dev/null || true
}

container_label() {
    container_field "$1" "{{index .Config.Labels \"$2\"}}"
}

container_status() {
    c_state=$(container_field "$1" '{{.State.Status}}')
    printf '%s' "${c_state:-gone}"
}

# The paths a run works on: its path arguments, or the folder it was started in.
container_targets() {
    t_paths=$(container_label "$1" vidfunnel.paths)
    if [ -n "${t_paths}" ]; then
        printf '%s' "${t_paths}"
    else
        container_label "$1" vidfunnel.cwd
    fi
}

status_is_running() {
    case "$1" in
        created|configured|initialized|exited|stopped|dead|removing|gone|"") return 1 ;;
        *) return 0 ;;
    esac
}

labelled_containers() {
    "${ENGINE}" ps -a --filter label=vidfunnel=1 --format '{{.Names}}' \
        || die "'${ENGINE} ps' failed; cannot list the vidfunnel containers on this host"
}

describe_container() {
    d_status=$(container_status "$1")
    d_stage=$(container_label "$1" vidfunnel.stage)
    d_cwd=$(container_label "$1" vidfunnel.cwd)
    d_paths=$(container_label "$1" vidfunnel.paths)
    d_started=$(container_label "$1" vidfunnel.started)
    if ! status_is_running "${d_status}"; then
        d_status="${d_status}, exit code $(container_field "$1" '{{.State.ExitCode}}')"
    fi
    say "'$1': ${d_stage:-unknown stage}, ${d_status}, started ${d_started:-at an unknown time}"
    if [ -n "${d_paths}" ]; then
        say "    in '${d_cwd}', paths '${d_paths}'"
    else
        say "    in '${d_cwd}', no path arguments (that folder)"
    fi
}

list_containers() {
    l_names=$(labelled_containers)
    if [ -z "${l_names}" ]; then
        say "No vidfunnel containers on this host (containers started on other hosts are not visible here)."
        return 0
    fi
    oldifs="$IFS"
    IFS="${NEWLINE}"
    for l_name in ${l_names}; do
        describe_container "${l_name}"
    done
    IFS="$oldifs"
    say "Follow one with '$(command_name) attach NAME' (the start of a name is enough), drain one with '$(command_name) stop NAME', remove the exited ones with '$(command_name) attach --clean'."
}

# Sets RESOLVED to the labelled container named $1, or the only one whose name starts with $1.
resolve_container() {
    [ -n "$1" ] || die "an empty container name was given"
    r_names=$(labelled_containers)
    RESOLVED=""
    r_matches=""
    r_count=0
    oldifs="$IFS"
    IFS="${NEWLINE}"
    for r_name in ${r_names}; do
        if [ "${r_name}" = "$1" ]; then
            RESOLVED="${r_name}"
            IFS="$oldifs"
            return 0
        fi
        case "${r_name}" in
            "$1"*)
                RESOLVED="${r_name}"
                r_matches="${r_matches}${r_matches:+, }'${r_name}'"
                r_count=$((r_count + 1))
                ;;
        esac
    done
    IFS="$oldifs"
    if [ "${r_count}" -eq 0 ]; then
        die "no vidfunnel container on this host is named '$1' or has a name starting with it; list them with '$(command_name) attach'"
    fi
    if [ "${r_count}" -gt 1 ]; then
        die "'$1' starts the names of more than one vidfunnel container: ${r_matches}; give more of the name"
    fi
    return 0
}

# Sets PICKED and PICKED_COUNT from the labelled containers started in CWD ($1: running or any).
pick_by_cwd() {
    PICKED=""
    PICKED_COUNT=0
    p_names=$(labelled_containers)
    oldifs="$IFS"
    IFS="${NEWLINE}"
    for p_name in ${p_names}; do
        [ "$(container_label "${p_name}" vidfunnel.cwd)" = "${CWD}" ] || continue
        if [ "$1" = running ]; then
            status_is_running "$(container_status "${p_name}")" || continue
        fi
        PICKED="${p_name}"
        PICKED_COUNT=$((PICKED_COUNT + 1))
    done
    IFS="$oldifs"
}

FOLLOW_NAME=""
FOLLOWER_PID=""
FOLLOW_SINCE=""
FOLLOW_STOPPING=0
FOLLOW_RESTARTED=0

start_follower() {
    if [ -n "${FOLLOW_SINCE}" ]; then
        "${ENGINE}" logs -f --since "${FOLLOW_SINCE}" "${FOLLOW_NAME}" </dev/null &
    else
        "${ENGINE}" logs -f "${FOLLOW_NAME}" </dev/null &
    fi
    FOLLOWER_PID=$!
}

request_stop() {
    "${ENGINE}" stop -t "${STOP_GRACE_SECONDS}" "$1" >/dev/null </dev/null &
}

detach_follow() {
    kill "${FOLLOWER_PID}" 2>/dev/null || true
    say "vidfunnel-podman: stopped following '${FOLLOW_NAME}' ($2); $3; follow it again with '$(command_name) attach ${FOLLOW_NAME}'" >&2 || true
    exit "$1"
}

# Ctrl+C reaches the wrapper and the follower ('podman logs -f' ends on it). The first
# one stops the container and the output is followed on from that moment; the next
# one only stops following. A run that is already stopping detaches at once.
on_follow_interrupt() {
    if [ "${FOLLOW_STOPPING}" -eq 1 ]; then
        detach_follow 130 "Ctrl+C again" "the container still finishes stopping"
    fi
    FOLLOW_STOPPING=1
    FOLLOW_SINCE=$(now_utc)
    FOLLOW_RESTARTED=0
    say "vidfunnel-podman: stopping '${FOLLOW_NAME}' (Ctrl+C again stops following; the container still finishes stopping)" >&2 || true
    request_stop "${FOLLOW_NAME}"
}

# Follows $1 until it exits, then removes it and exits with its exit code. With $2
# 'report', a line names the exit code (attach and stop).
follow_container() {
    FOLLOW_NAME="$1"
    trap 'on_follow_interrupt' INT
    trap 'detach_follow 129 "the terminal closed" "it keeps running"' HUP
    trap 'detach_follow 143 "SIGTERM" "it keeps running"' TERM
    trap 'detach_follow 131 "SIGQUIT" "it keeps running"' QUIT
    start_follower
    while :; do
        follower_status=0
        wait "${FOLLOWER_PID}" || follower_status=$?
        if kill -0 "${FOLLOWER_PID}" 2>/dev/null; then
            continue
        fi
        if ! status_is_running "$(container_status "${FOLLOW_NAME}")"; then
            break
        fi
        if [ -n "${FOLLOW_SINCE}" ] && [ "${FOLLOW_RESTARTED}" -eq 0 ]; then
            FOLLOW_RESTARTED=1
            start_follower
            continue
        fi
        if [ "${FOLLOW_STOPPING}" -eq 1 ]; then
            break
        fi
        say "vidfunnel-podman: the output of '${FOLLOW_NAME}' ended while it still runs ('${ENGINE} logs -f' exited with code ${follower_status}); it keeps running; follow it again with '$(command_name) attach ${FOLLOW_NAME}'" >&2
        exit 1
    done
    exit_code=$("${ENGINE}" wait "${FOLLOW_NAME}" 2>/dev/null) || exit_code=""
    case "${exit_code}" in
        ""|*[!0-9]*)
            say "vidfunnel-podman: could not read the exit code of '${FOLLOW_NAME}' ('${ENGINE} wait' printed '${exit_code}'); exiting with 1" >&2
            exit_code=1
            ;;
    esac
    if ! "${ENGINE}" rm "${FOLLOW_NAME}" >/dev/null 2>&1; then
        if [ "$(container_status "${FOLLOW_NAME}")" != gone ]; then
            say "vidfunnel-podman: could not remove the exited container '${FOLLOW_NAME}'; remove it with '${ENGINE} rm ${FOLLOW_NAME}'" >&2
        fi
    fi
    if [ "${2:-}" = report ]; then
        say "vidfunnel-podman: '${FOLLOW_NAME}' exited with code ${exit_code}; removed it" >&2
    fi
    trap - INT HUP TERM QUIT
    exit "${exit_code}"
}

clean_containers() {
    k_names=$(labelled_containers)
    k_removed=0
    k_failed=0
    oldifs="$IFS"
    IFS="${NEWLINE}"
    for k_name in ${k_names}; do
        k_status=$(container_status "${k_name}")
        if status_is_running "${k_status}" || [ "${k_status}" = gone ]; then
            continue
        fi
        say "'${k_name}' ($(container_label "${k_name}" vidfunnel.stage), started $(container_label "${k_name}" vidfunnel.started)) ${k_status} with exit code $(container_field "${k_name}" '{{.State.ExitCode}}'); removing it"
        if "${ENGINE}" rm "${k_name}" >/dev/null; then
            k_removed=$((k_removed + 1))
        else
            say "vidfunnel-podman: could not remove '${k_name}'" >&2
            k_failed=1
        fi
    done
    IFS="$oldifs"
    [ "${k_removed}" -gt 0 ] || [ "${k_failed}" -eq 1 ] || say "No exited vidfunnel containers to remove."
    return "${k_failed}"
}

attach_command() {
    if [ $# -gt 1 ]; then
        die "attach takes one container name (or the start of one), or --clean; '$*' is more than that"
    fi
    if [ $# -eq 1 ]; then
        case "$1" in
            --clean) clean_containers; exit $? ;;
            -*) die "attach takes a container name (or the start of one), or --clean; '$1' is not understood" ;;
        esac
        resolve_container "$1"
        follow_container "${RESOLVED}" report
    fi
    pick_by_cwd running
    if [ "${PICKED_COUNT}" -eq 0 ]; then
        pick_by_cwd any
    fi
    if [ "${PICKED_COUNT}" -eq 1 ]; then
        say "vidfunnel-podman: following '${PICKED}', started in this folder" >&2
        follow_container "${PICKED}" report
    fi
    list_containers
    exit 0
}

stop_command() {
    s_now=0
    s_target=""
    for s_arg in "$@"; do
        case "${s_arg}" in
            --now) s_now=1 ;;
            -*) die "stop takes --now and a container name (or the start of one); '${s_arg}' is not understood" ;;
            */*)
                die "'${s_arg}' is a path; 'stop' stops a run on this host by its container name. To stop every host's runs under a path use: vidfunnel stop-all ${s_arg}"
                ;;
            *)
                if [ -e "${s_arg}" ]; then
                    die "'${s_arg}' is a path; 'stop' stops a run on this host by its container name. To stop every host's runs under a path use: vidfunnel stop-all ${s_arg}"
                fi
                [ -z "${s_target}" ] || die "stop takes one container name; '${s_target}' and '${s_arg}' were given"
                s_target="${s_arg}"
                ;;
        esac
    done
    if [ -z "${s_target}" ]; then
        pick_by_cwd running
        if [ "${PICKED_COUNT}" -ne 1 ]; then
            if [ "${PICKED_COUNT}" -eq 0 ]; then
                say "vidfunnel-podman: no vidfunnel container started in '${CWD}' is running on this host; name the one to stop with '$(command_name) stop NAME'" >&2
            else
                say "vidfunnel-podman: ${PICKED_COUNT} vidfunnel containers started in '${CWD}' are running on this host; name the one to stop with '$(command_name) stop NAME'" >&2
            fi
            list_containers
            exit 1
        fi
        s_target="${PICKED}"
    else
        resolve_container "${s_target}"
        s_target="${RESOLVED}"
    fi
    s_status=$(container_status "${s_target}")
    if ! status_is_running "${s_status}"; then
        die "'${s_target}' is not running (${s_status}, exit code $(container_field "${s_target}" '{{.State.ExitCode}}')); see its output with '$(command_name) attach ${s_target}'"
    fi
    FOLLOW_SINCE=$(now_utc)
    if [ "${s_now}" -eq 1 ]; then
        say "vidfunnel-podman: stopping '${s_target}' now (SIGTERM; Ctrl+C stops following, the container still finishes stopping)" >&2
        FOLLOW_STOPPING=1
        request_stop "${s_target}"
    else
        "${ENGINE}" kill --signal USR1 "${s_target}" >/dev/null \
            || die "could not send USR1 to '${s_target}'"
        say "vidfunnel-podman: asked '${s_target}' to drain: the items in progress finish and no new ones start (Ctrl+C stops it at once instead)" >&2
    fi
    follow_container "${s_target}" report
}

if [ $# -gt 0 ] && { [ "$1" = attach ] || [ "$1" = stop ]; }; then
    CWD=$(pwd)
    wrapper_command="$1"
    shift
    if [ "${wrapper_command}" = attach ]; then
        attach_command "$@"
    else
        stop_command "$@"
    fi
fi

short_hash() {
    if command -v sha256sum >/dev/null 2>&1; then
        h_digest=$(printf '%s\n%s\n' "$1" "$2" | sha256sum)
    elif command -v shasum >/dev/null 2>&1; then
        h_digest=$(printf '%s\n%s\n' "$1" "$2" | shasum -a 256)
    elif command -v openssl >/dev/null 2>&1; then
        h_digest=$(printf '%s\n%s\n' "$1" "$2" | openssl dgst -sha256 -r)
    else
        die "none of sha256sum, shasum or openssl is on PATH; the detached container's name needs one (or set VIDFUNNEL_ATTACHED=1)"
    fi
    printf '%s' "${h_digest}" | cut -c1-12
}

refuse_duplicate() {
    say "vidfunnel-podman: '$1' ($(container_label "$1" vidfunnel.stage), started $(container_label "$1" vidfunnel.started)) is already running on this host for '$(container_targets "$1")'; not starting another. Follow it with '$(command_name) attach $1', or drain it with '$(command_name) stop $1'." >&2
    exit 1
}

report_stale() {
    {
        say "vidfunnel-podman: an earlier '$1' ($(container_label "$1" vidfunnel.stage), started $(container_label "$1" vidfunnel.started)) has $(container_status "$1") with exit code $(container_field "$1" '{{.State.ExitCode}}') and was not removed (its wrapper did not see it end); its last lines:"
        "${ENGINE}" logs --tail 20 "$1" 2>&1 | sed 's/^/    /'
    } >&2
    "${ENGINE}" rm "$1" >/dev/null || die "could not remove the earlier container '$1'; remove it with '${ENGINE} rm $1'"
    say "vidfunnel-podman: removed the earlier '$1'" >&2
}

check_before_start() {
    b_names=$(labelled_containers)
    oldifs="$IFS"
    IFS="${NEWLINE}"
    for b_name in ${b_names}; do
        b_status=$(container_status "${b_name}")
        if [ "${b_name}" = "${RUN_NAME}" ]; then
            if status_is_running "${b_status}"; then
                refuse_duplicate "${b_name}"
            fi
            if [ "${b_status}" != gone ]; then
                report_stale "${b_name}"
            fi
            continue
        fi
        if status_is_running "${b_status}" && [ "$(container_targets "${b_name}")" = "${RUN_TARGETS}" ]; then
            refuse_duplicate "${b_name}"
        fi
    done
    IFS="$oldifs"
}

start_detached() {
    check_before_start
    run_status=0
    "$@" >/dev/null || run_status=$?
    if [ "${run_status}" -ne 0 ]; then
        if [ "$(container_status "${RUN_NAME}")" != gone ]; then
            "${ENGINE}" rm "${RUN_NAME}" >/dev/null 2>&1 || true
        fi
        die "'${ENGINE} run -d' failed with code ${run_status}; nothing is running as '${RUN_NAME}'"
    fi
    say "vidfunnel-podman: running detached as '${RUN_NAME}'; Ctrl+C stops it; '$(command_name) attach ${RUN_NAME}' follows it again from another terminal" >&2
    follow_container "${RUN_NAME}"
}

state_dir="${HOME}/.local/state/vidfunnel"
cache_dir="${HOME}/.cache/vidfunnel"

RUN_IMAGE="${IMAGE}"
[ -n "${VIDFUNNEL_IMAGE_DIGEST}" ] && RUN_IMAGE="${IMAGE}@${VIDFUNNEL_IMAGE_DIGEST}"

abs_path() {
    p="$1"
    if [ -d "$p" ]; then
        (cd "$p" && pwd)
    else
        d=$(dirname "$p")
        b=$(basename "$p")
        d=$(cd "$d" && pwd)
        if [ "$d" = "/" ]; then printf '/%s\n' "$b"; else printf '%s/%s\n' "$d" "$b"; fi
    fi
}

MOUNTS=""

add_mount() {
    new="$1"
    [ "${new}" != "/" ] || die "refusing to mount '/' into the container: it would cover the image's own root; give a path below it"
    kept=""
    old_list="${MOUNTS}"
    MOUNTS=""
    oldifs="$IFS"
    IFS='
'
    for m in ${old_list}; do
        case "${new}/" in "${m}/"*) MOUNTS="${old_list}"; IFS="$oldifs"; return 0 ;; esac
    done
    for m in ${old_list}; do
        case "${m}/" in "${new}/"*) ;; *) kept="${kept}${m}
" ;; esac
    done
    IFS="$oldifs"
    MOUNTS="${kept}${new}
"
}

mount_folder() {
    logical=$(cd "$1" && pwd) || die "cannot resolve the folder '$1' to an absolute path"
    add_mount "${logical}"
    physical=$(cd "$1" && pwd -P) || die "cannot resolve the symlinks of the folder '$1'"
    [ "${physical}" = "${logical}" ] || add_mount "${physical}"
}

mount_path() {
    if [ -d "$1" ]; then
        mount_folder "$1"
    else
        mount_folder "$(dirname -- "$1")"
    fi
    hop="$1"
    hops=0
    while [ -L "${hop}" ]; do
        hops=$((hops + 1))
        [ "${hops}" -le 40 ] || die "more than 40 symlinks lead from '$1'; not following them"
        target=$(readlink -- "${hop}") || die "cannot read the symlink '${hop}'"
        case "${target}" in
            /*) ;;
            *) target="$(cd "$(dirname -- "${hop}")" && pwd -P)/${target}" ;;
        esac
        [ -e "${target}" ] || die "the symlink '${hop}' leads to '${target}', which does not exist"
        if [ -d "${target}" ] && [ -L "${target}" ]; then
            add_mount "$(abs_path "${target}")"
        elif [ -d "${target}" ]; then
            mount_folder "${target}"
        else
            mount_folder "$(dirname -- "${target}")"
        fi
        hop="${target}"
    done
}

CWD=$(pwd)
mount_path "${CWD}"

for home_dir in "${state_dir}" "${cache_dir}"; do
    mkdir -p -- "${home_dir}" || die "cannot create '${home_dir}' on the host for the container's HOME"
    mount_path "${home_dir}"
done

QUARANTINES=""

SUBCOMMAND=""

path_option_kind() {
    option_kind=""
    case "$1" in
        --quarantine) option_kind="quarantine"; return 0 ;;
        --db) option_kind="db"; return 0 ;;
    esac
    case "${SUBCOMMAND}" in
        retire)
            is_option_prefix "$1" "--quarantine" "--q" && option_kind="quarantine" ;;
        index)
            is_option_prefix "$1" "--db" "--d" && option_kind="db" ;;
        find)
            if is_option_prefix "$1" "--db" "--d"; then
                option_kind="db"
            elif is_option_prefix "$1" "--root" "--r"; then
                option_kind="existing"
            fi
            ;;
        report)
            if is_option_prefix "$1" "--db" "--d"; then
                option_kind="db"
            elif is_option_prefix "$1" "--from" "--fr"; then
                option_kind="existing"
            fi
            ;;
    esac
    [ -n "${option_kind}" ]
}

prepare_quarantine() {
    [ -n "$1" ] || die "--quarantine needs a directory"
    mkdir -p -- "$1" || die "cannot create the quarantine directory '$1' on the host"
    q=$(abs_path "$1") || die "cannot resolve the quarantine directory '$1'"
    mount_path "$1"
    QUARANTINES="${QUARANTINES}${q}
"
}

prepare_db() {
    [ -n "$1" ] || die "--db needs a path"
    db_parent=$(dirname -- "$1")
    mkdir -p -- "${db_parent}" || die "cannot create the folder '${db_parent}' for the index database on the host"
    mount_path "${db_parent}"
}

prepare_option_value() {
    case "$1" in
        quarantine) prepare_quarantine "$2" ;;
        db) prepare_db "$2" ;;
        existing) if [ -e "$2" ]; then mount_path "$2"; fi ;;
    esac
}

HELP_GIVEN=0
FIRST_PATH=""
PATH_LABEL=""

# The path arguments of a detached run, made absolute, name it and label it.
add_path_argument() {
    a_path=$(abs_path "$1") || die "cannot resolve '$1' to an absolute path"
    [ -n "${FIRST_PATH}" ] || FIRST_PATH="${a_path}"
    PATH_LABEL="${PATH_LABEL}${PATH_LABEL:+ }${a_path}"
}

count=$#
i=0
pending=""
skip_value=0
while [ "${i}" -lt "${count}" ]; do
    arg="$1"
    shift
    if [ -n "${pending}" ]; then
        prepare_option_value "${pending}" "${arg}"
        pending=""
    elif [ "${skip_value}" -eq 1 ]; then
        skip_value=0
    else
        case "${arg}" in
            --*=*)
                if path_option_kind "${arg%%=*}"; then
                    prepare_option_value "${option_kind}" "${arg#*=}"
                fi
                ;;
            -*)
                if path_option_kind "${arg}"; then
                    pending="${option_kind}"
                elif [ -z "${SUBCOMMAND}" ] && is_option_prefix "${arg}" "--launcher" "--l"; then
                    skip_value=1
                fi
                case "${arg}" in
                    -h|--h|--he|--hel|--help|--version) HELP_GIVEN=1 ;;
                esac
                ;;
            *)
                if [ -z "${SUBCOMMAND}" ]; then
                    SUBCOMMAND="${arg}"
                elif [ -e "${arg}" ]; then
                    add_path_argument "${arg}"
                fi
                ;;
        esac
    fi
    if [ -e "${arg}" ]; then
        mount_path "${arg}"
    fi
    set -- "$@" "${arg}"
    i=$((i + 1))
done

oldifs="$IFS"
IFS='
'
for q in ${QUARANTINES}; do
    covered=0
    for m in ${MOUNTS}; do
        case "${q}/" in "${m}/"*) covered=1 ;; esac
    done
    [ "${covered}" -eq 1 ] || die "the quarantine directory '${q}' is not under any mounted path; refusing to run, because retire would write the originals into the container's filesystem"
done
IFS="$oldifs"

set -- "${RUN_IMAGE}" "$@"

oldifs="$IFS"
IFS='
'
for m in ${MOUNTS}; do
    set -- -v "${m}:${m}" "$@"
done
IFS="$oldifs"

# The host's machine id, read-only, so the folder locks a container run writes name
# this machine (the image has none, and vidfunnel would fall back to the boot id).
if [ -f /etc/machine-id ] && [ -s /etc/machine-id ]; then
    set -- -v /etc/machine-id:/etc/machine-id:ro "$@"
fi

set -- --workdir "${CWD}" "$@"
set -- -e "HOME=${HOME}" "$@"
set -- --security-opt label=disable "$@"
# Supplementary groups: a share writable only through a group the user belongs to
# (root:media 775 on a NAS mount) is read-only inside the container unless the
# container process keeps those groups. Under --userns=keep-id the group ids inside
# the namespace map to subordinate gids, not to the host's, so adding them by number
# cannot work; crun's 'keep-groups' keeps the host's own groups. runc has no such
# option and ignores it silently. Docker uses no user namespace here, so the numeric
# ids are the host's and --group-add by number works.
supplementary_gids() {
    primary=$(id -g)
    for gid in $(id -G); do
        [ "${gid}" = "${primary}" ] || printf '%s\n' "${gid}"
    done
}
# Owner uid, group gid and permission bits (octal) of a path, as 'UID GID MODE':
# 'stat -c' on GNU and busybox, 'stat -f' with '%Lp' on macOS and the BSDs. Prints
# nothing when stat fails or answers in another shape.
owner_group_mode() {
    fields=$(stat -c '%u %g %a' "$1" 2>/dev/null) || fields=$(stat -f '%u %g %Lp' "$1" 2>/dev/null) || fields=""
    set -- ${fields}
    [ "$#" -eq 3 ] || return 0
    for field in "$@"; do
        case "${field}" in ''|*[!0-9]*) return 0 ;; esac
    done
    printf '%s %s %s\n' "$1" "$2" "$3"
}
# The gid through which alone the invoking user can write the folder $1, or nothing:
# the folder is owned by another uid, its mode gives the group write and others no
# write, and its group is one of the user's supplementary groups (supplementary_gids
# leaves out the primary group, which every runtime keeps). A folder stat cannot
# read needs no warning.
group_only_gid() {
    set -- $(owner_group_mode "$1")
    [ "$#" -eq 3 ] || return 0
    [ "$1" != "$(id -u)" ] || return 0
    case "$3" in *[2367]?) ;; *) return 0 ;; esac
    case "$3" in *[2367]) return 0 ;; esac
    for gid in $(supplementary_gids); do
        if [ "${gid}" = "$2" ]; then
            printf '%s\n' "$2"
            return 0
        fi
    done
}
# One warning for each mounted folder that is writable only through a supplementary
# group, for a runtime that cannot keep those groups.
warn_group_only_mounts() {
    oldifs="$IFS"
    IFS='
'
    for m in ${MOUNTS}; do
        IFS="$oldifs"
        needed=$(group_only_gid "${m}")
        if [ -n "${needed}" ]; then
            say "vidfunnel-podman: warning: '${m}' is writable only through group ${needed}, and the OCI runtime '$1' cannot keep supplementary groups inside the container; writes there may fail (crun keeps them)" >&2
        fi
    done
    IFS="$oldifs"
}
if [ "${ENGINE}" = "podman" ]; then
    runtime=$(podman info --format '{{.Host.OCIRuntime.Name}}' 2>/dev/null || true)
    case "${runtime}" in
        crun|*/crun) set -- --group-add keep-groups "$@" ;;
        *) warn_group_only_mounts "${runtime:-unknown}" ;;
    esac
    set -- --userns=keep-id "$@"
else
    for gid in $(supplementary_gids); do
        set -- --group-add "${gid}" "$@"
    done
    set -- --user "$(id -u):$(id -g)" "$@"
fi
# A container terminal only when stdin AND stdout are terminals. With stdout a pipe
# ('vidfunnel report | less'), -t would put the terminal into raw mode and make podman
# forward keystrokes into the container while the pipe's reader (less) reads the same
# terminal: the two race for every key, and podman leaves echo off on exit when its
# stdout is not the terminal. In a pipeline nothing in vidfunnel needs stdin: its one
# prompt (retire --destroy-originals-now) refuses without a terminal unless --yes.
DETACH=0
case "${SUBCOMMAND}" in
    plan|convert|verify) DETACH=1 ;;
esac
if [ "${HELP_GIVEN}" -eq 1 ] || [ "${VIDFUNNEL_ATTACHED:-}" = 1 ]; then
    DETACH=0
fi
if [ "${DETACH}" -eq 1 ]; then
    RUN_NAME="vidfunnel-${SUBCOMMAND}-$(short_hash "${CWD}" "${FIRST_PATH}")"
    RUN_TARGETS="${PATH_LABEL:-${CWD}}"
    set -- "${ENGINE}" run -d --name "${RUN_NAME}" --label vidfunnel=1 \
        --label "vidfunnel.stage=${SUBCOMMAND}" --label "vidfunnel.cwd=${CWD}" \
        --label "vidfunnel.paths=${PATH_LABEL}" --label "vidfunnel.started=$(now_utc)" "$@"
else
    if [ -t 0 ] && [ -t 1 ]; then
        set -- -it "$@"
    fi
    set -- "${ENGINE}" run --rm "$@"
fi

if [ -n "${VIDFUNNEL_IONICE_CLASS:-}" ] && command -v ionice >/dev/null 2>&1; then
    set -- ionice -c "${VIDFUNNEL_IONICE_CLASS}" "$@"
fi
if [ -n "${VIDFUNNEL_NICE:-}" ]; then
    set -- nice -n "${VIDFUNNEL_NICE}" "$@"
fi

if [ "${DETACH}" -eq 1 ]; then
    start_detached "$@"
fi
exec "$@"

# End of File #
