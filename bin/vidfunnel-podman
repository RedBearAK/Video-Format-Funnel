#!/bin/sh
# vidfunnel-podman: run vidfunnel inside its container image. Every argument that
# is an existing path on the host is bind-mounted read-write at the same absolute
# path inside the container, as is the current directory (the container's working
# directory), and the container runs as the invoking uid/gid. --quarantine and --db
# targets are created on the host first and mounted. HOME is passed in, with its
# vidfunnel state and cache folders mounted. --install-command and
# --uninstall-command run on the host and link 'vidfunnel' to this wrapper.
# See HANDOFF.md section 8.

VERSION="20261107"

set -eu

VIDFUNNEL_IMAGE_DIGEST=""

IMAGE="${VIDFUNNEL_IMAGE:-localhost/vidfunnel:latest}"
BUILD=0

usage() {
    cat <<EOF2
Usage: vidfunnel-podman [wrapper options] [vidfunnel arguments]

Runs vidfunnel in its container image with podman (or docker, if podman is not
installed). Wrapper options are recognised only before the first other argument;
everything from there on goes to vidfunnel unchanged.

Wrapper options:
  --image IMAGE      image to run (default: ${IMAGE}; environment: VIDFUNNEL_IMAGE)
  --build            build the image from the Containerfile next to this script's
                     repo, tag it as the image above, then run (or just build, when
                     no vidfunnel arguments follow)
  --wrapper-version  print the wrapper version
  -h, --help         this text

What the wrapper does:
  Every vidfunnel argument that is an existing file or folder on the host is
  resolved to an absolute path and bind-mounted read-write at the same path inside
  the container. The current directory is mounted too and used as the working
  directory. A path inside another mounted folder is not mounted separately.
  Paths that vidfunnel will create are prepared on the host first, so they are
  not written into the container's own filesystem (removed with the container):
    --quarantine DIR, --quarantine=DIR   DIR is created on the host (mkdir -p)
                                         and mounted; after 'retire', the
                                         abbreviations argparse accepts
                                         (--quar DIR) are treated alike
    --db PATH, --db=PATH                 the folder holding PATH is created on
                                         the host (mkdir -p) and mounted
  A --quarantine directory that cannot be created or is still not under a
  mounted path stops the wrapper before the container starts.
  The container gets your HOME (-e HOME=\$HOME), and the wrapper creates
  \$HOME/.local/state/vidfunnel (the index database) and \$HOME/.cache/vidfunnel
  (the ffmpeg capability cache) on the host and mounts both at the same path,
  so they persist between runs, are owned by you, and nothing reaches the
  current directory by way of '~'. An unset or empty HOME stops the wrapper.
  The container runs with --rm, --userns=keep-id (podman) or --user uid:gid
  (docker) so files are owned by you, and --security-opt label=disable for SELinux
  hosts. It gets a terminal (-it) only when stdin is one.

Installing the command:
  --install-command and --uninstall-command, as the first vidfunnel argument
  (after other options such as --yes), run on the host instead of in the
  container: they make or remove a symlink 'vidfunnel' in ~/.local/bin (or
  /usr/local/bin with --system) pointing at this wrapper, so that 'vidfunnel'
  runs the container. With a python3 of 3.9 or newer on the host, the repo's
  own installer does it (with --launcher set to this wrapper), including the
  offer to add ~/.local/bin to PATH. Without one, the wrapper does it itself:
  it replaces only a symlink to this wrapper or to bin/vidfunnel, refuses
  anything else, prints the PATH line to add instead of editing any file, and
  for --system needs /usr/local/bin to be writable (otherwise it prints the
  sudo ln -s command to run); its --uninstall-command removes only a symlink
  to this wrapper or to bin/vidfunnel. The repo's installer removes only a
  symlink to this wrapper.

Environment:
  VIDFUNNEL_IMAGE          image name, overridden by --image
  VIDFUNNEL_NICE           if set, run the container command under nice -n VALUE
  VIDFUNNEL_IONICE_CLASS   if set and ionice exists, run under ionice -c VALUE

Pinning: the variable VIDFUNNEL_IMAGE_DIGEST near the top of this script is empty
by default. When it holds a digest (sha256:...), the wrapper runs IMAGE@DIGEST, so
the image changes only when the digest is edited on purpose.
EOF2
}

say() { printf '%s\n' "$*"; }
die() { printf 'vidfunnel-podman: %s\n' "$*" >&2; exit 1; }

while [ $# -gt 0 ]; do
    case "$1" in
        --image) [ $# -ge 2 ] || die "--image needs a value"; IMAGE="$2"; shift 2 ;;
        --build) BUILD=1; shift ;;
        --wrapper-version) say "vidfunnel-podman ${VERSION}"; exit 0 ;;
        -h|--help) usage; exit 0 ;;
        *) break ;;
    esac
done

self="$0"
while [ -L "$self" ]; do
    target=$(readlink "$self")
    case "$target" in
        /*) self="$target" ;;
        *) self="$(dirname "$self")/$target" ;;
    esac
done
bindir=$(cd "$(dirname "$self")" && pwd -P)
root=$(dirname "$bindir")
wrapper="${bindir}/vidfunnel-podman"
plain_launcher="${bindir}/vidfunnel"

[ -n "${HOME:-}" ] || die "HOME is not set (or is empty); it is needed for the container's HOME and for --install-command"
case "${HOME}" in
    /*) ;;
    *) die "HOME is '${HOME}', not an absolute path; refusing to guess where the container's HOME should be" ;;
esac

install_hint() {
    if [ "$(uname -s)" = "Darwin" ]; then
        say "  brew install podman"
        return
    fi
    id=""
    [ -r /etc/os-release ] && id=$(. /etc/os-release && echo "${ID:-} ${ID_LIKE:-}")
    case " $id " in
        *" opensuse"*|*" suse "*) say "  sudo zypper install podman" ;;
        *" fedora "*|*" rhel "*) say "  sudo dnf install podman" ;;
        *" debian "*|*" ubuntu "*) say "  sudo apt install podman" ;;
        *" arch "*) say "  sudo pacman -S podman" ;;
        *" alpine "*) say "  sudo apk add podman" ;;
        *) say "  install podman with your package manager" ;;
    esac
}

if command -v podman >/dev/null 2>&1; then
    ENGINE="podman"
elif command -v docker >/dev/null 2>&1; then
    ENGINE="docker"
    say "vidfunnel-podman: podman was not found, using 'docker' instead" >&2
else
    {
        say "vidfunnel-podman: neither podman nor docker was found on PATH. Install podman with:"
        install_hint
    } >&2
    exit 1
fi

if [ "${BUILD}" -eq 1 ]; then
    [ -f "${root}/Containerfile" ] || die "no Containerfile in '${root}'"
    say "Building image '${IMAGE}' from '${root}/Containerfile' with ${ENGINE}"
    "${ENGINE}" build -t "${IMAGE}" -f "${root}/Containerfile" "${root}"
    if [ $# -eq 0 ]; then
        say "Built '${IMAGE}'"
        exit 0
    fi
fi

install_mode=""
for arg in "$@"; do
    case "${arg}" in
        --install-command) install_mode="install"; break ;;
        --uninstall-command) install_mode="uninstall"; break ;;
        -*) ;;
        *) break ;;
    esac
done

host_python_ok() {
    command -v python3 >/dev/null 2>&1 || return 1
    python3 -c 'import sys; sys.exit(0 if sys.version_info >= (3, 9) else 1)' 2>/dev/null
}

link_is_ours() {
    raw=$(readlink "$1") || return 1
    case "${raw}" in
        /*) ;;
        *) raw="$(dirname "$1")/${raw}" ;;
    esac
    if [ -e "${raw}" ]; then
        raw="$(cd "$(dirname "${raw}")" && pwd -P)/$(basename "${raw}")"
    fi
    [ "${raw}" = "${wrapper}" ] || [ "${raw}" = "${plain_launcher}" ]
}

describe_target() {
    if [ -L "$1" ]; then
        printf "a symlink to '%s'" "$(readlink "$1")"
    elif [ -d "$1" ]; then
        printf 'a directory'
    else
        printf 'a file that is not a symlink'
    fi
}

path_advice() {
    user_bin="${HOME}/.local/bin"
    case ":${PATH:-}:" in
        *":${user_bin}:"*|*":${user_bin}/:"*) return 0 ;;
    esac
    say "'${user_bin}' is not on PATH."
    shell_name=$(basename "${SHELL:-}")
    case "${shell_name}" in
        bash)
            say "For bash, add this line to '~/.bashrc':"
            say '    export PATH="$HOME/.local/bin:$PATH"' ;;
        zsh)
            say "For zsh, add this line to '~/.zprofile':"
            say '    export PATH="$HOME/.local/bin:$PATH"' ;;
        fish)
            say "For fish, add this line to '~/.config/fish/config.fish':"
            say '    fish_add_path -g $HOME/.local/bin' ;;
        *)
            say "Add this line, or its equivalent, to your shell's startup file:"
            say '    export PATH="$HOME/.local/bin:$PATH"' ;;
    esac
    say "This wrapper edits no file; until then, 'vidfunnel' is found only by its full path."
}

sh_install_command() {
    scope="user"
    for arg in "$@"; do
        case "${arg}" in
            --install-command|--uninstall-command|--yes) ;;
            --user) scope="user" ;;
            --system) scope="system" ;;
            *) die "'${arg}' is not understood by the wrapper's own installer (it takes --user, --system and --yes)" ;;
        esac
    done
    if [ "${scope}" = "system" ]; then
        link_dir="/usr/local/bin"
    else
        link_dir="${HOME}/.local/bin"
    fi
    link="${link_dir}/vidfunnel"
    if [ "${install_mode}" = "uninstall" ]; then
        if [ ! -e "${link}" ] && [ ! -L "${link}" ]; then
            say "Nothing installed at '${link}'."
            return 0
        fi
        link_is_ours "${link}" || die "'${link}' is $(describe_target "${link}"), not a symlink to '${wrapper}' or '${plain_launcher}'; leaving it alone"
        if [ "${scope}" = "system" ] && [ ! -w "${link_dir}" ]; then
            die "'${link_dir}' is not writable; remove the link by hand with: sudo rm '${link}'"
        fi
        rm -f -- "${link}" || die "could not remove '${link}'"
        { [ -e "${link}" ] || [ -L "${link}" ]; } && die "'${link}' is still there after removing it"
        say "Removed '${link}'."
        return 0
    fi
    if [ "${scope}" = "system" ] && [ ! -w "${link_dir}" ]; then
        die "'${link_dir}' is not writable; make the link by hand with: sudo ln -s '${wrapper}' '${link}'"
    fi
    if [ -e "${link}" ] || [ -L "${link}" ]; then
        link_is_ours "${link}" || die "'${link}' already exists and is $(describe_target "${link}"); not overwriting it. Remove it yourself if it should be replaced."
    fi
    mkdir -p -- "${link_dir}" || die "cannot create '${link_dir}'"
    temp_link="${link}.vidfunnel-tmp"
    rm -f -- "${temp_link}"
    ln -s -- "${wrapper}" "${temp_link}" || die "could not create '${temp_link}'"
    mv -f -- "${temp_link}" "${link}" || die "could not move '${temp_link}' to '${link}'"
    [ -L "${link}" ] && [ "$(readlink "${link}")" = "${wrapper}" ] || die "'${link}' is not a symlink to '${wrapper}' after installing"
    say "Installed '${link}' -> '${wrapper}'."
    if [ "${scope}" = "user" ]; then
        path_advice
    fi
    return 0
}

if [ -n "${install_mode}" ]; then
    [ -f "${root}/vidfunnel/installer.py" ] || die "the repo's installer '${root}/vidfunnel/installer.py' is missing"
    if host_python_ok; then
        exec env PYTHONPATH="${root}${PYTHONPATH:+:$PYTHONPATH}" python3 -m vidfunnel "$@" --launcher "${wrapper}"
    fi
    say "No python3 of 3.9 or newer on the host; using the wrapper's own installer (it edits no shell startup file)."
    sh_install_command "$@"
    exit 0
fi

state_dir="${HOME}/.local/state/vidfunnel"
cache_dir="${HOME}/.cache/vidfunnel"

RUN_IMAGE="${IMAGE}"
[ -n "${VIDFUNNEL_IMAGE_DIGEST}" ] && RUN_IMAGE="${IMAGE}@${VIDFUNNEL_IMAGE_DIGEST}"

abs_path() {
    p="$1"
    if [ -d "$p" ]; then
        (cd "$p" && pwd)
    else
        d=$(dirname "$p")
        b=$(basename "$p")
        d=$(cd "$d" && pwd)
        if [ "$d" = "/" ]; then printf '/%s\n' "$b"; else printf '%s/%s\n' "$d" "$b"; fi
    fi
}

MOUNTS=""

add_mount() {
    new="$1"
    kept=""
    old_list="${MOUNTS}"
    MOUNTS=""
    oldifs="$IFS"
    IFS='
'
    for m in ${old_list}; do
        case "${new}/" in "${m}/"*) MOUNTS="${old_list}"; IFS="$oldifs"; return 0 ;; esac
    done
    for m in ${old_list}; do
        case "${m}/" in "${new}/"*) ;; *) kept="${kept}${m}
" ;; esac
    done
    IFS="$oldifs"
    MOUNTS="${kept}${new}
"
}

CWD=$(pwd)
add_mount "${CWD}"

for home_dir in "${state_dir}" "${cache_dir}"; do
    mkdir -p -- "${home_dir}" || die "cannot create '${home_dir}' on the host for the container's HOME"
    add_mount "$(abs_path "${home_dir}")"
done

QUARANTINES=""

SEEN_RETIRE=0

is_quarantine_option() {
    [ "$1" = "--quarantine" ] && return 0
    [ "${SEEN_RETIRE}" -eq 1 ] || return 1
    case "$1" in
        --q*) case "--quarantine" in "$1"*) return 0 ;; esac ;;
    esac
    return 1
}

prepare_quarantine() {
    [ -n "$1" ] || die "--quarantine needs a directory"
    mkdir -p -- "$1" || die "cannot create the quarantine directory '$1' on the host"
    q=$(abs_path "$1") || die "cannot resolve the quarantine directory '$1'"
    add_mount "${q}"
    QUARANTINES="${QUARANTINES}${q}
"
}

prepare_db() {
    [ -n "$1" ] || die "--db needs a path"
    db_parent=$(dirname -- "$1")
    mkdir -p -- "${db_parent}" || die "cannot create the folder '${db_parent}' for the index database on the host"
    add_mount "$(abs_path "${db_parent}")"
}

count=$#
i=0
pending=""
while [ "${i}" -lt "${count}" ]; do
    arg="$1"
    shift
    if [ "${pending}" = "quarantine" ]; then
        prepare_quarantine "${arg}"
        pending=""
    elif [ "${pending}" = "db" ]; then
        prepare_db "${arg}"
        pending=""
    else
        case "${arg}" in
            --db) pending="db" ;;
            --db=*) prepare_db "${arg#--db=}" ;;
            --*=*)
                if is_quarantine_option "${arg%%=*}"; then
                    prepare_quarantine "${arg#*=}"
                fi
                ;;
            retire) SEEN_RETIRE=1 ;;
            *)
                if is_quarantine_option "${arg}"; then
                    pending="quarantine"
                fi
                ;;
        esac
    fi
    if [ -e "${arg}" ]; then
        add_mount "$(abs_path "${arg}")"
    fi
    set -- "$@" "${arg}"
    i=$((i + 1))
done

oldifs="$IFS"
IFS='
'
for q in ${QUARANTINES}; do
    covered=0
    for m in ${MOUNTS}; do
        case "${q}/" in "${m}/"*) covered=1 ;; esac
    done
    [ "${covered}" -eq 1 ] || die "the quarantine directory '${q}' is not under any mounted path; refusing to run, because retire would write the originals into the container's filesystem"
done
IFS="$oldifs"

set -- "${RUN_IMAGE}" "$@"

oldifs="$IFS"
IFS='
'
for m in ${MOUNTS}; do
    set -- -v "${m}:${m}" "$@"
done
IFS="$oldifs"

set -- --workdir "${CWD}" "$@"
set -- -e "HOME=${HOME}" "$@"
set -- --security-opt label=disable "$@"
if [ "${ENGINE}" = "podman" ]; then
    set -- --userns=keep-id "$@"
else
    set -- --user "$(id -u):$(id -g)" "$@"
fi
if [ -t 0 ]; then
    set -- -it "$@"
fi
set -- "${ENGINE}" run --rm "$@"

if [ -n "${VIDFUNNEL_IONICE_CLASS:-}" ] && command -v ionice >/dev/null 2>&1; then
    set -- ionice -c "${VIDFUNNEL_IONICE_CLASS}" "$@"
fi
if [ -n "${VIDFUNNEL_NICE:-}" ]; then
    set -- nice -n "${VIDFUNNEL_NICE}" "$@"
fi

exec "$@"

# End of File #
